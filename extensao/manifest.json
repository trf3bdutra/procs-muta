{
  "manifest_version": 3,
  "name": "Muta · Assistente de gabinete",
  "short_name": "Muta",
  "version": "0.14.0",
  "description": "Prontuário do processo, leitura dos autos e aba Minuta (matriz, Collectio, conformidade) ao lado do PJe. Gab. Des. Fed. Carlos Muta.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Abrir o Muta ao lado do PJe",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "side_panel": {
    "default_path": "painel.html"
  },
  "background": {
    "service_worker": "fundo.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.gabinete-cmt.com/*",
    "https://gabinete-cmt.com/*",
    "https://pje2g.trf3.jus.br/*",
    "https://frontend-pje.app.trf3.jus.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pje2g.trf3.jus.br/*",
        "https://frontend-pje.app.trf3.jus.br/*"
      ],
      "js": [
        "conteudo-pje.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
